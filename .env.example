# RadWeave Reporting — service configuration.
#
# Set these in the NEW "RadWeave Reporting" Vercel project (Pro plan).
# This service is deployed separately from the radmindai website project and
# shares no environment with it beyond pointing at the same Supabase project.

# --- Supabase (same project as the website) ---------------------------------
# Used to validate incoming Bearer tokens against Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side data access (credits, templates, usage logs). Never sent to any
# client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Provider ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: enables similar-report style examples for Personal Reporting
# Profile. Report generation continues normally without it.
VOYAGE_API_KEY=

# --- Diagnostics --------------------------------------------------------------
# Shared secret for GET /v1/ready, the deep readiness check that makes one real
# call to Supabase Auth, Supabase service-role and Anthropic and reports which
# credential actually works. Send it as the X-Diagnostics-Key header.
#
# Optional. Leave it unset and /v1/ready answers 404 like any other unknown
# route — the endpoint simply does not exist. Set it (any long random string)
# when you need to diagnose a deployment:
#
#   curl -H "X-Diagnostics-Key: $DIAGNOSTICS_KEY" https://<host>/v1/ready
DIAGNOSTICS_KEY=

# --- Service ------------------------------------------------------------------
PORT=8787
# comma-separated; used only by the local dev server's permissive CORS
ALLOWED_ORIGINS=http://localhost:3000
