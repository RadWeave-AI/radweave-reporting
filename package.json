{
  "name": "radweave-reporting",
  "version": "0.1.0",
  "private": true,
  "description": "RadWeave Reporting — standalone report generation service. Called by the RadWeave website, RadWeave Desktop, and (later) hospital API customers.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --import ./test/register-alias.mjs --watch src/dev-server.ts",
    "start": "node --import ./test/register-alias.mjs src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register-alias.mjs --experimental-test-module-mocks --test test/*.test.ts test/browser-*-generation.test.mjs",
    "test:rls-auth": "node scripts/verify-rls-auth.ts",
    "test:parity": "node --import ./test/register-alias.mjs scripts/parity-harness.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/supabase-js": "^2.112.3",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
